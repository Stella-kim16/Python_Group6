# ==============================================================================
# Smart Energy Management System — Environment Configuration Template
# Copy this file to `.env` and fill in your values. Never commit `.env` to Git!
# ==============================================================================

# Subsystem 1: Data & SQLite Database Paths
RAW_CSV_PATH=data/raw/Energy_consumption.csv
DB_PATH=data/processed/smart_energy.db
PROCESSED_CSV_PATH=data/processed/enriched_energy_data.csv
PROCESSED_JSON_PATH=data/processed/enriched_energy_data.json

# Subsystem 2: OpenAI API Key for AI Sustainability Coach / Reasoning
OPENAI_API_KEY=your_openai_api_key_here

# Web Interface: Host Port Mapping for Streamlit
STREAMLIT_PORT=8501
